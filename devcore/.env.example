# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Firebase.
# Sem estas variáveis o jogo usa o ranking local (offline) automaticamente.
# Nunca coloque chaves reais em arquivos versionados: .env.local já está no .gitignore.
# Passo a passo: docs/FIREBASE_SETUP.md

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# true = mostra registros FICTÍCIOS (rotulados como "exemplo") no Pergaminho, para demonstração.
VITE_DEMO_RANKING=false
