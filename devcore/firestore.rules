rules_version = '2';

// Regras do ranking do DevCore.
// - Qualquer um lê o ranking.
// - Cada jogador (Auth anônimo) só cria/atualiza o PRÓPRIO documento players/{uid}.
// - Tipos validados; nome de 2 a 16 caracteres; classe conhecida.
// - XP e recorde do Relâmpago só crescem, com teto de incremento por escrita.
// Limitação conhecida: a pontuação é calculada no cliente (ver docs/DECISIONS.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function validPlayer(d, uid) {
      return d.keys().hasOnly(['uid', 'name', 'heroClass', 'xp', 'level', 'lightning', 'bossesDefeated', 'title', 'updatedAt'])
        && d.keys().hasAll(['uid', 'name', 'heroClass', 'xp', 'level', 'lightning', 'bossesDefeated', 'updatedAt'])
        && d.uid == uid
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 16
        && d.heroClass in ['alchemist', 'mage']
        && d.xp is int && d.xp >= 0
        && d.level is int && d.level >= 1 && d.level <= 1000
        && d.lightning is int && d.lightning >= 0
        && d.bossesDefeated is int && d.bossesDefeated >= 0 && d.bossesDefeated <= 4
        && (!('title' in d) || d.title == null || (d.title is string && d.title.size() <= 40))
        && d.updatedAt == request.time;
    }

    match /players/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && validPlayer(request.resource.data, uid)
        && request.resource.data.xp <= 1500
        && request.resource.data.lightning <= 3000;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && validPlayer(request.resource.data, uid)
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 1500
        && request.resource.data.lightning >= resource.data.lightning
        && request.resource.data.lightning - resource.data.lightning <= 3000
        && request.resource.data.bossesDefeated >= resource.data.bossesDefeated;

      allow delete: if false;
    }

    // Todo o resto é fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
